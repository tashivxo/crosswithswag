# Copy to deploy/api.env on the VPS (chmod 600). Loaded by docker-compose.prod.yml and postgres.

POSTGRES_DB=swag
POSTGRES_USER=swag
POSTGRES_PASSWORD=generate-a-strong-password

SPRING_DATASOURCE_PASSWORD=generate-a-strong-password

APP_CATALOG_PATH=/app/catalog/catalog.json

CORS_ALLOWED_ORIGINS=https://crosswithswag.co.za,https://www.crosswithswag.co.za,https://crosswithswag.vercel.app,https://crosswithswag-git-v4-branch-tashivxos-projects.vercel.app

PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
PAYFAST_RETURN_URL=https://crosswithswag-git-v4-branch-tashivxos-projects.vercel.app/order/confirmed
PAYFAST_CANCEL_URL=https://crosswithswag-git-v4-branch-tashivxos-projects.vercel.app/checkout
PAYFAST_NOTIFY_URL=https://api.crosswithswag.co.za/v1/payfast/itn

RESEND_API_KEY=
MAIL_FROM=orders@crosswithswag.co.za
MAIL_ORDERS_TO=orders@crosswithswag.co.za
SHIPPING_PAXI_CENTS=6000