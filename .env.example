NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Coming-soon landing page. Set to 1 to replace `/` with the poster.
NEXT_PUBLIC_COMING_SOON=

# Jotform waitlist (server only, never NEXT_PUBLIC_). Without all four the API returns 503.
JOTFORM_API_KEY=
JOTFORM_FORM_ID=
JOTFORM_EMAIL_QID=
JOTFORM_CONSENT_QID=
# Optional. Defaults: "Yes" and https://api.jotform.com (EU accounts: https://eu-api.jotform.com)
JOTFORM_CONSENT_VALUE=
JOTFORM_API_BASE=
