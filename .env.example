NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# V3.3.3 Jotform coming-soon poster. Ignored on V4_branch (`/` is Figma 21:277).
NEXT_PUBLIC_COMING_SOON=

# Jotform waitlist (server only, never NEXT_PUBLIC_). Without all four the API returns 503.
JOTFORM_API_KEY=
JOTFORM_FORM_ID=
JOTFORM_EMAIL_QID=
JOTFORM_CONSENT_QID=
# Optional. Defaults: "Yes" and https://api.jotform.com (EU accounts: https://eu-api.jotform.com)
JOTFORM_CONSENT_VALUE=
JOTFORM_API_BASE=

# Figma REST for V4 frame export (agents + scripts/figma-rest.mjs). Not used by Next.js at runtime.
# Same value as Cloud Agent secret FIGMA_TOKEN. Create at https://www.figma.com/developers/api#access-tokens
FIGMA_TOKEN=

# --- Spring API (local / V4 checkout backend) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/swag
SPRING_DATASOURCE_USERNAME=swag
SPRING_DATASOURCE_PASSWORD=swag_local
APP_CATALOG_PATH=../packages/catalog/catalog.json
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PayFast (sandbox). Never commit live keys.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Resend (transactional mail from orders@crosswithswag.co.za)
RESEND_API_KEY=
MAIL_FROM=orders@crosswithswag.co.za

# Paxi collect flat fee in cents (Marcus TBD; placeholder 6000 = R60)
SHIPPING_PAXI_CENTS=6000
